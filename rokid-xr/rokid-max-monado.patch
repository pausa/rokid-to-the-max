+/*
+ * Mount rotation: the LSM6DSR in the Rokid Max reports in a
+ * (left, down, back) frame; Monado device space is (right, up, back).
+ * Verified by 6-pose rest calibration (see project calibration.md).
+ * diag(-1, -1, 1) is a proper rotation (180 deg about Z), so it applies
+ * to both accel and gyro without breaking handedness.
+ */
+static void
+rokid_apply_mount_rotation(struct xrt_vec3 *v)
+{
+	v->x = -v->x;
+	v->y = -v->y;
