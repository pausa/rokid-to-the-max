+		struct xrt_vec3 axis = {
+		    an.y * wup.z - an.z * wup.y,
+		    an.z * wup.x - an.x * wup.z,
+		    an.x * wup.y - an.y * wup.x,
+		};
+		float axis_len = m_vec3_len(axis);
+		float dot = m_vec3_dot(an, wup);
+		if (dot > 1.0f) {
